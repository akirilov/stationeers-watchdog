{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug executable 'stationeers-save-monitor'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=stationeers-save-monitor"
                ]
            },
            "args": ["${input:saveDir}"]
        },
        {
            "name": "Debug unit tests in executable 'stationeers-save-monitor'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=stationeers-save-monitor"
                ]
            }
        }
    ],
    "inputs": [
        {
            "id": "saveDir",
            "type": "promptString",
            "description": "Path to Stationeers save directory",
            "default": "./example"
        }
    ]
}