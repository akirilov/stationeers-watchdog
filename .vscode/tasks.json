{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "cargo",
			"command": "build",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
		},
		{
			"label": "run",
			"type": "cargo",
			"command": "run",
			"problemMatcher": [
				"$rustc"
			],
			"args": ["${input:saveDir}"]
		},
		{
			"label": "clippy",
			"type": "cargo",
			"command": "clippy",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
			"args": ["--fix"]
		},
		{
			"label": "clean",
			"type": "cargo",
			"command": "clean",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
		},
		{
			"label": "test",
			"type": "cargo",
			"command": "test",
			"problemMatcher": [
				"$rustc"
			],
			"group": "test",
		},
		{
			"label": "fmt",
			"type": "cargo",
			"command": "fmt",
			"problemMatcher": [
				"$rustc"
			],
			"group": "build",
		}
	],
	 "inputs": [
        {
            "id": "saveDir",
            "type": "promptString",
            "description": "Path to Stationeers save directory",
            "default": "./example"
        }
    ]
}